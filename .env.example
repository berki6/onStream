# OnStream Video Streaming Platform - Environment Configuration

# ==========================================
# SECURITY SETTINGS
# ==========================================

# JWT Secret Key - REQUIRED for production
# Generate a secure random key: openssl rand -hex 32
SECRET_KEY=your-super-secret-key-change-in-prod

# Environment (development, staging, production)
ENV=development

# ==========================================
# DATABASE CONFIGURATION
# ==========================================

# Database URL - supports SQLite, PostgreSQL, MySQL
# SQLite (default for development)
DATABASE_URL=sqlite:///./onstream.db

# PostgreSQL example:
# DATABASE_URL=postgresql://username:password@localhost:5432/onstream

# MySQL example:
# DATABASE_URL=mysql://username:password@localhost:3306/onstream

# ==========================================
# REDIS CONFIGURATION
# ==========================================

# Redis URL for job queuing and caching
REDIS_URL=redis://localhost:6379/1

# Celery broker URL (if using Celery instead of direct Redis)
CELERY_BROKER_URL=redis://localhost:6379/0

# Celery result backend
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Default Celery queue
CELERY_DEFAULT_QUEUE=default

# Enable Celery (0 = disabled, 1 = enabled)
CELERY_ENABLED=0

# ==========================================
# LOGGING & MONITORING
# ==========================================

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log file path
LOG_FILE=python.log

# Enable Prometheus metrics (true/false)
PROMETHEUS_ENABLED=true

# Enable analytics/video view tracking (true/false)
ANALYTICS_ENABLED=false

# Debug mode (true/false)
DEBUG=false

# ==========================================
# VIDEO PROCESSING SETTINGS
# ==========================================

# Maximum upload file size in bytes (default: 100MB)
MAX_UPLOAD_SIZE=104857600

# Maximum video duration in seconds (default: 1 hour)
MAX_VIDEO_DURATION_SECONDS=3600

# Maximum video title length
MAX_TITLE_LENGTH=200

# Maximum items per page in list endpoints
MAX_LIST_LIMIT=100

# Thumbnail dimensions
THUMBNAIL_WIDTH=320
THUMBNAIL_HEIGHT=180

# ==========================================
# FILE STORAGE DIRECTORIES
# ==========================================

# Directory for uploaded video files
VIDEO_UPLOAD_DIR=data/uploads

# Directory for processed video files
VIDEO_STORAGE_DIR=data/videos

# Directory for HLS streaming segments
VIDEO_HLS_DIR=data/hls

# Directory for generated thumbnails
VIDEO_THUMBNAIL_DIR=data/thumbnails

# ==========================================
# AUTHENTICATION SETTINGS
# ==========================================

# JWT token expiration time in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ==========================================
# EXTERNAL SERVICES
# ==========================================

# Sentry DSN for error monitoring (optional)
SENTRY_DSN=

# Internal API key for protecting sensitive endpoints
INTERNAL_API_KEY=

# ==========================================
# PRODUCTION NOTES
# ==========================================
#
# For production deployment:
# 1. Set a strong SECRET_KEY
# 2. Use PostgreSQL or MySQL instead of SQLite
# 3. Configure Redis cluster for high availability
# 4. Set up proper file storage (S3, GCS, etc.)
# 5. Configure monitoring and logging
# 6. Set ENV=production
# 7. Enable SSL/TLS
# 8. Configure reverse proxy (nginx, etc.)