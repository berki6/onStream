# OnStream Video Streaming Platform - Environment Configuration

# ==========================================
# SECURITY SETTINGS
# ==========================================

SECRET_KEY=your-super-secret-key-change-in-prod
ENV=development

# ==========================================
# DATABASE CONFIGURATION
# ==========================================

# Local default (tests/dev without Docker)
DATABASE_URL=sqlite:///./onstream.db

# PostgreSQL (recommended / Docker Compose)
# DATABASE_URL=postgresql+psycopg2://onstream:onstream@localhost:5432/onstream

# ==========================================
# REDIS CONFIGURATION
# ==========================================

REDIS_URL=redis://localhost:6379/1

# ==========================================
# STORAGE
# ==========================================

# local | s3 | minio | r2
STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=onstream
S3_REGION=us-east-1
# For R2, prefer S3_REGION=auto (empty/us-east-1 also map to auto)
# path | virtual (empty = registry default per backend)
S3_ADDRESSING_STYLE=
# Edge host for CDN purge URLs (empty → PUBLIC_API_BASE_URL)
PUBLIC_PLAYBACK_BASE_URL=

# ==========================================
# EMAIL (password reset — Laravel-style drivers)
# ==========================================
# Local/lab: EMAIL_PROVIDER=log  → full message (token + deep links) in API logs
# Production: EMAIL_PROVIDER=smtp (+ SMTP_*); log/none rejected when ENV=production
# none | log | smtp
EMAIL_PROVIDER=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@onstream.local
SMTP_USE_TLS=true

# ==========================================
# LOGGING & MONITORING
# ==========================================

LOG_LEVEL=INFO
LOG_FILE=python.log
PROMETHEUS_ENABLED=true
ANALYTICS_ENABLED=false
DEBUG=false
SENTRY_DSN=

# ==========================================
# VIDEO PROCESSING SETTINGS
# ==========================================

MAX_UPLOAD_SIZE=104857600
MAX_VIDEO_DURATION_SECONDS=3600
MAX_TITLE_LENGTH=200
MAX_LIST_LIMIT=100
THUMBNAIL_WIDTH=320
THUMBNAIL_HEIGHT=180
VIDEO_UPLOAD_DIR=data/uploads
VIDEO_STORAGE_DIR=data/videos
VIDEO_HLS_DIR=data/hls
VIDEO_THUMBNAIL_DIR=data/thumbnails

# ==========================================
# AUTHENTICATION / CORS
# ==========================================

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
PASSWORD_RESET_EXPIRE_MINUTES=30
AUTH_RATE_LIMIT_PER_MINUTE=20

# Comma-separated. Empty allows * in non-production. Required in production.
CORS_ORIGINS=

INTERNAL_API_KEY=

# ==========================================
# AI MEDIA INTELLIGENCE
# ==========================================

# Master switch (default off for CI). Feature flags below are gated by AI_ENABLED.
AI_ENABLED=false
AI_CAPTIONS_ENABLED=true
AI_CHAPTERS_ENABLED=true
AI_MODERATION_ENABLED=true
AI_EMBEDDINGS_ENABLED=true
AI_SMART_THUMBNAIL_ENABLED=true
WHISPER_MODEL=tiny
EMBEDDING_MODEL=all-MiniLM-L6-v2
AI_MODERATION_THRESHOLD=0.7
# Providers: faster_whisper | mock  /  sentence_transformers | mock  /  heuristic
AI_CAPTIONS_PROVIDER=faster_whisper
AI_EMBEDDINGS_PROVIDER=sentence_transformers
AI_MODERATION_PROVIDER=heuristic

# ==========================================
# LIVE STREAMING (MediaMTX + OBS/VLC)
# ==========================================

LIVE_ENABLED=true
MEDIAMTX_RTMP_URL=rtmp://localhost:1935/live
MEDIAMTX_HLS_URL=http://localhost:8888
LIVE_HLS_DIR=data/live
LIVE_ABR_ENABLED=false
LIVE_ABR_LADDER=360:800,720:2500,1080:5000
LIVE_NORMALIZE_ENABLED=true
LIVE_HLS_SEGMENT_SECONDS=1
MEDIAMTX_RTSP_URL=rtsp://127.0.0.1:8554
MEDIAMTX_AUTH_SECRET=
PUBLIC_RTMP_BASE_URL=rtmp://localhost:1935/live
PUBLIC_API_BASE_URL=http://localhost:8000
LIVE_HEALTH_ENABLED=true
LIVE_STALE_SECONDS=20
PLAYBACK_CDN_HEADERS_ENABLED=true
MEDIAMTX_API_URL=http://localhost:9997
MEDIAMTX_API_USER=
MEDIAMTX_API_PASS=
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
MEDIA_PYAV_ENABLED=true
QOE_CANARY_ENABLED=true
# WHIP/WHEP base for live create + /demo/whip/ (use LAN IP for phone browsers)
PUBLIC_WEBRTC_BASE_URL=http://localhost:8889
PUBLIC_HTTPS_BASE_URL=
CDN_PROVIDER=none
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
BUNNY_API_KEY=
BUNNY_PULL_ZONE_ID=
FFMPEG_HWACCEL=
QUALITY_GATE_ENABLED=false
QUALITY_GATE_STRICT=false
QUALITY_GATE_MIN_VMAF=70
DEMO_PLAYER_ENABLED=false


# ==========================================
# PRODUCTION NOTES
# ==========================================
# 1. Set a strong SECRET_KEY and ENV=production
# 2. Use PostgreSQL + Redis + S3/MinIO (see docker-compose.yml)
# 3. Set CORS_ORIGINS explicitly
# 4. Run: alembic upgrade head
# 5. Start API + worker separately (or docker compose up)
# 6. AI worker: docker compose --profile ai up worker-ai
#    or pip install -r requirements-ai.txt with AI_ENABLED=true
# 7. Live: MediaMTX (RTMP :1935, HLS :8888, WebRTC :8889) — see docs/PLAYBACK_CLIENTS.md
# 8. Edge: docker compose --profile edge up caddy
# 9. Observability: docker compose --profile obs up prometheus grafana
# 10. GPU encode: docker compose --profile gpu up worker-gpu
# 11. TURN: docker compose --profile turn -f docker-compose.yml -f docker-compose.turn.yml up
